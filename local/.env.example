# Copy to local/.env (git-ignored) and fill in. No secrets here: those are files in
# local/secrets/. Compose refuses to start while a required value is empty.

# Compose project; keeps containers and volumes apart from any other Windmill stack on the host.
COMPOSE_PROJECT_NAME=windmill-custom

# Read by the upstream docker-compose.yml before the override replaces them. The database URL
# itself is the secret file local/secrets/windmill_database_url.
WM_IMAGE=windmill-custom:local
DATABASE_URL=

# Required. What users type in the browser, e.g. PUBLIC_HOST=windmill.corp.example and
# PUBLIC_BASE_URL=https://windmill.corp.example. PUBLIC_BASE_URL must be https, have no
# trailing slash, and include the port when it is not 443.
PUBLIC_HOST=
PUBLIC_BASE_URL=

# Host addresses Caddy publishes 443 and 80 on (`port` or `ip:port`).
CADDY_HTTPS_BIND=443
CADDY_HTTP_BIND=80

# TLS: "internal" (Caddy's local CA, LAN only), an ACME e-mail address for a public
# certificate, or "/certs/cert.pem /certs/key.pem" with ./local/certs mounted (see compose).
CADDY_TLS=internal

# Required. Networks allowed to reach the break-glass password login (space-separated CIDRs).
ADMIN_ALLOWED_CIDRS=

# Forking lets any developer copy a workspace; keep it off unless you need it.
DISABLE_WORKSPACE_FORK=true

# Set to 0 to run no official (non-fork) image at all; this loses editor code intelligence.
WINDMILL_EXTRA_REPLICAS=1

# Entra ID app registration (see local/README.md). The client secret is the file
# local/secrets/entra_client_secret.
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Comma-separated e-mail domains that may sign in.
ALLOWED_EMAIL_DOMAINS=
# Link an Entra identity to a pre-existing Windmill account with the same e-mail. Leave false
# unless you have checked every existing account.
ADOPT_EXISTING_ACCOUNTS=false
RECONCILE_INTERVAL=15m

#LOG_MAX_SIZE=20m
#LOG_MAX_FILE=10
