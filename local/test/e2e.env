# TEST ONLY: environment of the windmill-custom-e2e compose project (docker-compose.test.yml).
# Holds no secrets: local/test/e2e.sh generates those in local/test/run/ (git-ignored).
COMPOSE_PROJECT_NAME=windmill-custom-e2e
WM_IMAGE=windmill-custom:local
DATABASE_URL=

PUBLIC_HOST=localhost
PUBLIC_BASE_URL=https://localhost:3443
CADDY_HTTPS_BIND=127.0.0.1:3443
CADDY_HTTP_BIND=127.0.0.1:3480
CADDY_TLS=internal
# Host traffic reaches published ports through the network gateway of the fixed test subnet.
ADMIN_ALLOWED_CIDRS=172.31.250.1/32
DISABLE_WORKSPACE_FORK=true
WINDMILL_EXTRA_REPLICAS=1

# mock-entra's tenant and app; any GUID works, these are reserved for this test.
ENTRA_TENANT_ID=0e2e0000-0000-4000-8000-000000000001
ENTRA_CLIENT_ID=0e2e0000-0000-4000-8000-000000000002
ALLOWED_EMAIL_DOMAINS=e2e.example.org
ADOPT_EXISTING_ACCOUNTS=false
RECONCILE_INTERVAL=1m
MOCK_ENTRA_BIND_PORT=3444
